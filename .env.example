# Extraction API URL
# Local dev with Cloudflare Worker: VITE_OVERTURE_PROXY_URL=http://localhost:8787
# Production on Vercel: leave empty (defaults to /api on same domain)
# Production on Cloudflare Pages: VITE_OVERTURE_PROXY_URL=https://draw2data-proxy.abhishekrawat426.workers.dev
VITE_OVERTURE_PROXY_URL=http://localhost:8787

# Firebase (optional — login + analytics features)
# Create a project at https://console.firebase.google.com
# Enable Authentication > Google sign-in + Firestore Database
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
